# /etc/systemd/system/syncnotes.service
[Unit]
Description=SyncNotes 实时同步服务器
After=network-online.target
Wants=network-online.target

[Service]
User=syncnotes
WorkingDirectory=/var/lib/syncnotes
ExecStart=/usr/local/bin/syncnotes-server --bind 0.0.0.0:7700 --db /var/lib/syncnotes/syncnotes.db --files-dir /var/lib/syncnotes/files
Environment=RUST_LOG=info
# 创建好账号后取消下一行注释以关闭注册
# Environment=SYNCNOTES_ALLOW_REGISTER=false
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
